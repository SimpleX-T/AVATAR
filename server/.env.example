PORT=8787
PROJECT_AVATAR_DEVICE_TOKEN=replace-with-a-long-random-device-token

# Create an app at https://dashboard.privy.io
# Enable Email under Authentication > Login methods.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Set to production behind HTTPS. Local development stays false.
NODE_ENV=development

# Create TWO private channels. Keep all six values on the server only.
# Without these, the dashboard remains in clearly labelled local-demo mode.
THINGSPEAK_SOIL_CHANNEL_ID=
THINGSPEAK_SOIL_WRITE_KEY=
THINGSPEAK_SOIL_READ_KEY=
THINGSPEAK_ENV_CHANNEL_ID=
THINGSPEAK_ENV_WRITE_KEY=
THINGSPEAK_ENV_READ_KEY=
